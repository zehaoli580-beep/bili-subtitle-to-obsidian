{
  "name": "bili-subtitle-exporter",
  "version": "1.0.0",
  "private": true,
  "description": "提取 B 站视频字幕并导出为 Obsidian 可识别的 Markdown",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-packager . BiliSubtitleToObsidian --platform=win32 --arch=x64 --out=release --overwrite --asar --ignore=\"^/release\""
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.0.0"
  }
}
